########################################
# DockGo Environment Configuration
########################################

########################
# Server Configuration
########################

# Port DockGo listens on inside the container.
# Must match the container-side port in docker-compose.
PORT=3131

# Allowed CORS origin.
# Change in production to your frontend origin.
CORS_ORIGIN=http://localhost:3131

# Path to session persistence file.
# Default: /app/data/sessions.json
# SESSION_STORE_PATH=/app/data/sessions.json

# JSON file persisting registered stack definitions.
# Default (server): /app/data/stacks.json
# STACK_STORE_PATH=/app/data/stacks.json

# JSON file persisting stack action history.
# Default: /app/data/stack_history.json
# STACK_HISTORY_PATH=/app/data/stack_history.json


########################
# Authentication
########################

# --- Option 1: Legacy API Token ---
# API_TOKEN=replace_with_strong_random_token


# --- Option 2: User Login (Recommended) ---
# AUTH_USERNAME=admin

# Development convenience (NOT recommended for production):
# AUTH_PASSWORD=replace_with_strong_password

# Production recommended approach:
# Pre-hash your password using:
#   dockgo hash-password yourpassword
#
# NOTE:
# If using docker-compose inline environment variables,
# escape '$' as '$$'.
#
# AUTH_PASSWORD_HASH=$2a$10$examplehashedpasswordstring

# Required when using username/password authentication.
# Used to sign session cookies.
# Generate with:
#   openssl rand -hex 32
#
# AUTH_SECRET=replace_with_random_secret

# Optional bcrypt cost (default: 10)
# AUTH_BCRYPT_COST=10


########################
# Multi-Host Agents (Server)
########################

# Where the server persists registered agent records.
# Default: /app/data/agents.json
# AGENT_STORE_PATH=/app/data/agents.json

# Per-agent maximum number of concurrent operations relayed over one channel.
# Default: 8
# AGENT_MAX_CONCURRENT=8

# Lifetime of the JWT issued to an agent channel on registration.
# Reconnect with a fresh key issues a new token.
# Default: 1h
# AGENT_JWT_TTL=1h

# Secret used to sign agent JWTs. Falls back to AUTH_SECRET when unset.
# Generate with: openssl rand -hex 32
# AGENT_JWT_SECRET=replace_with_random_secret


########################
# DockGo Agent (Agent host)
########################

# DOCKGO_SERVER_URL=ws://dockgo:3131/api/ws/agent
# AGENT_KEY=replace_with_generated_agent_key
# AGENT_NAME=media-server

# Reconnect backoff (agent-side)
# AGENT_RECONNECT_MIN=5s
# AGENT_RECONNECT_MAX=60s
# AGENT_RECONNECT_MULT=2.0
# AGENT_HEARTBEAT_INTERVAL=30s


########################
# Compose Security
########################

# Restrict Compose working directories.
# Comma-separated list of allowed base paths.
#
# Example:
# ALLOWED_COMPOSE_PATHS=/opt/docker,/home/user/docker
#
# ALLOWED_COMPOSE_PATHS=

# Map host paths to mounted container paths for Compose projects.
# Only use this when DockGo sees Compose projects at a different path than
# the Docker host.
#
# Linux recommended setup:
# - mount /home/user/docker:/home/user/docker
# - do NOT set COMPOSE_PATH_MAPPING
# - use "Host Native" in DockGo
#
# Windows typical setup:
# - mount D:\Docker:/compose
# - set COMPOSE_PATH_MAPPING=D:\Docker:/compose
# - use "Mapped" in DockGo
#
# Linux alternate setup if you intentionally mount to /compose:
# - mount /home/user/docker:/compose
# - set COMPOSE_PATH_MAPPING=/home/user/docker:/compose
# - use "Mapped" in DockGo
#
# Format: HOST_PATH:CONTAINER_PATH
# Example:
# COMPOSE_PATH_MAPPING=D:\Docker:/compose
#
# COMPOSE_PATH_MAPPING=


########################
# Notifications (Apprise)
########################

# The base URL of your Apprise container/server (default: http://apprise:8000)
# APPRISE_API_HOST=http://my-notifier:8000

# The destination URL(s) to send notifications to, comma separated.
# Example:
# APPRISE_URL=ntfy://token@host/topic
#
# Optional queue size (default: 100)
# APPRISE_QUEUE_SIZE=100


########################
# Background Scan Schedule
########################

# How often DockGo checks for updates.
# Examples: 12h, 30m, 6h
SCAN_INTERVAL=24h


########################
# Orchestrator Settings
########################

# Grace period before force-stopping container (seconds)
# DOCKGO_STOP_TIMEOUT=10

# Max wait time for a container to become healthy (seconds)
# DOCKGO_HEALTH_TIMEOUT=60

# Initial runtime check for containers without healthchecks (seconds)
# DOCKGO_INITIAL_RUNTIME_CHECK=10

# Stability monitoring window post-healthcheck (seconds)
# DOCKGO_STABILITY_WINDOW=20


########################
# Logging
########################

# Write logs to a persistent rotating file inside your data mount
# Default: empty (Stdout only). Example: /app/data/logs/dockgo.log
# LOG_FILE_PATH=/app/data/logs/dockgo.log

# Maximum size in megabytes of the log file before it gets rotated
# Default: 10
# LOG_MAX_SIZE=10

# Maximum number of old log files to retain
# Default: 5
# LOG_MAX_BACKUPS=5

# Maximum number of days to retain old log files based on the timestamp encoded in their filename
# Default: 28
# LOG_MAX_AGE=28

# Compress the rotated log files using gzip
# Default: true
# LOG_COMPRESS=true

# LOG_FORMAT=json
# LOG_LEVEL=info
# DOCKGO_DEBUG=false
